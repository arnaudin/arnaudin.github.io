# ryanarnaudin.com
#
# Deployed from the site repo by .github/workflows/jekyll.yml -- edit it there,
# not in cPanel File Manager, or the next deploy will overwrite your changes.
#
# Cleaned 2026-09-14: removed a byte-identical duplicate of the AutoSSL block
# below, the LiteSpeed WP Cache plugin config, an empty WordPress block, and a
# 2015 PHP handler comment. All were left over from the WordPress site that
# used to live here; this is a static Jekyll build now. Also removed a
# hand-written "SSL FILE REDIRECT" that duplicated the AutoSSL rule -- it could
# never fire, because the block below terminates every non-HTTPS request with
# [R=301,L] first, and unlike that block it was not wrapped in <IfModule>,
# so it would have 500'd the site if mod_rewrite ever went missing.

### AutoSSL-Satellite Don't Edit Below This Line ###
<IfModule mod_rewrite.c>
	RewriteEngine On
	# Force HTTPS
	RewriteCond %{HTTPS} off
	RewriteCond %{HTTP:X-Forwarded-SSL} !on
	RewriteRule ^(.*)$ "https://%{HTTP_HOST}%{REQUEST_URI}" [R=301,L]
</IfModule>
### AutoSSL-Satellite Don't Edit Above This Line ###

# --- Static site ------------------------------------------------------------
# The AutoSSL block above is generated by cPanel and carries its own "don't
# edit" markers, so it is kept verbatim. Everything below is ours.

# Serve the site's own 404 page. Without this LiteSpeed returns its stock
# "Proudly powered by" page, so /404.html was never actually reached.
ErrorDocument 404 /404.html

# A .txt has no in-band way to declare its encoding the way HTML and XML do.
# Without a charset on the response, browsers fall back to windows-1252 and
# every multi-byte character in /llms.txt renders as mojibake.
AddDefaultCharset UTF-8
